PORT=5000
MONGODB_URI=your_mongodb_connection_string_here

JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

AUTH_IP_LIMIT_PER_HOUR=100
PASSWORD_RESET_LIMIT_PER_HOUR=5

# Password reset email (nodemailer). Leave unset in dev: emails are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESET_PASSWORD_URL=http://localhost:5000/reset-password
PASSWORD_RESET_EXPIRES_IN=30
